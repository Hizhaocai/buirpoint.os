# Safe to expose to browsers. The key is Supabase's publishable key, never the
# SUPABASE_SECRET_KEY or SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://api.buirpoint.top
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credential used by the read-only miniapp API query layer.
# Never expose this value to browsers or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=
